{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "marketplace",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	"workers_dev": false,
	"preview_urls": true,
	"routes": [{ "pattern": "mp.pawang.dev", "custom_domain": true }],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"]
	},
	"observability": { "enabled": true }
}
